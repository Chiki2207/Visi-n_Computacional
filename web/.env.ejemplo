# Configuración de la web. Copiar a web/.env y cambiar los valores. La leen los dos servicios.

# --- Servicio de IA (solo lo usa el servidor web; NO publicarlo a internet) ---
IA_HOST=127.0.0.1
IA_PUERTO=8001
# Clave compartida web <-> IA. Generar una larga:  python -c "import secrets;print(secrets.token_urlsafe(32))"
IA_TOKEN=CAMBIAR_POR_UNA_CLAVE_LARGA
IA_MAX_MB=40

# --- Servidor web (página + Excel) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PUERTO=3000
IA_URL=http://127.0.0.1:8001
# Carpeta de datos: la misma de la ventana de escritorio (clases con su estudiantes.xlsx + fotos/, y listas/).
DATOS=datos
MAX_MB=25
SESION_HORAS=12
